{
  "name": "sql-apps",
  "version": "0.1.1",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=22 <23 || >=24 <25"
  },
  "scripts": {
    "build": "node scripts/build-provenance.mjs",
    "app:check": "node scripts/check-application.mjs",
    "app:build": "node scripts/build-application.mjs",
    "app:check-api": "node scripts/check-application-api.mjs",
    "setup:check": "node scripts/setup-check.mjs",
    "setup": "node scripts/setup.mjs",
    "projects": "node scripts/projects.mjs",
    "guide": "node scripts/guide.mjs",
    "workspace:check": "node scripts/workspace-check.mjs",
    "consent": "node scripts/local-consent.mjs",
    "typecheck": "tsc --noEmit",
    "test": "npm run build && tsc && npm run app:check && node --test dist/tests/*.test.js tests/setup.test.mjs tests/setup-install.test.mjs tests/setup-journey.test.mjs tests/guide.test.mjs tests/workspace.test.mjs tests/workspace-runtime.test.mjs tests/local-consent.test.mjs tests/projects.test.mjs && node scripts/test-examples.mjs",
    "start": "node dist/src/server.js",
    "azure": "node dist/src/cli.js",
    "local": "node dist/src/local-cli.js",
    "plugin:check": "node scripts/check-plugin.mjs",
    "plugin:install": "node scripts/install-plugin.mjs",
    "infra:build": "az bicep build --file infra/main.bicep --outfile dist/main.json",
    "infra:test-demo": "node --test tests/demo-infra.test.mjs",
    "sql:build": "dotnet build sql/database.sqlproj --output dist/sql",
    "sql:tools": "dotnet tool restore",
    "dab:validate": "node dist/src/validate-dab.js"
  },
  "dependencies": {
    "@azure/functions": "4.16.5",
    "@azure/identity": "4.13.3",
    "@azure/keyvault-secrets": "4.11.2",
    "@azure/msal-browser": "5.25.0",
    "@azure/storage-blob": "12.34.0",
    "@azure/storage-queue": "12.32.0",
    "@fastify/static": "10.1.5",
    "@opentelemetry/api": "1.9.1",
    "@opentelemetry/sdk-trace-base": "2.11.0",
    "fastify": "5.12.5",
    "jose": "6.2.12",
    "zod": "4.6.5"
  },
  "devDependencies": {
    "@azure/static-web-apps-cli": "2.0.10",
    "@types/node": "22.20.4",
    "ajv": "8.20.0",
    "ajv-formats": "3.0.1",
    "esbuild": "0.28.2",
    "typescript": "5.9.3"
  },
  "overrides": {
    "adm-zip": "0.6.1",
    "selfsigned": "5.5.0",
    "tmp": "0.2.7"
  }
}
